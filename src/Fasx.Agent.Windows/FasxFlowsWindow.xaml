<Window x:Class="Fasx.Agent.Windows.FasxFlowsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FASX — Flows"
        Width="900"
        Height="720"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B1020"
        Foreground="#F4F7FF">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="FASX AUTOMATION" FontSize="11" FontWeight="Bold" Foreground="#8FB7FF" />
            <TextBlock Text="FASX Flows" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0" />
            <TextBlock Text="Build simple local workflows from approved actions. Every run shows a preview and asks for confirmation."
                       FontSize="12" Foreground="#AAB6CC" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#151D32" CornerRadius="16" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CREATE A FLOW" FontSize="11" FontWeight="Bold" Foreground="#9CAAC4" />
                        <TextBlock Text="Flow name" FontSize="12" Margin="0,14,0,5" />
                        <TextBox x:Name="FlowNameTextBox" Height="34" Padding="8" MaxLength="40" />

                        <TextBlock Text="Action type" FontSize="12" Margin="0,14,0,5" />
                        <ComboBox x:Name="ActionTypeComboBox"
                                  Height="34"
                                  SelectedIndex="0"
                                  SelectionChanged="ActionType_SelectionChanged">
                            <ComboBoxItem Content="Open a built-in app" Tag="OpenBuiltInApp" />
                            <ComboBoxItem Content="Open an HTTPS website" Tag="OpenHttpsWebsite" />
                            <ComboBoxItem Content="Choose and open a folder" Tag="PickAndOpenFolder" />
                        </ComboBox>

                        <StackPanel x:Name="ApplicationPickerPanel" Margin="0,12,0,0">
                            <TextBlock Text="Built-in app" FontSize="12" Margin="0,0,0,5" />
                            <ComboBox x:Name="BuiltInAppComboBox" Height="34" SelectedIndex="0">
                                <ComboBoxItem Content="Notepad" Tag="notepad" />
                                <ComboBoxItem Content="Calculator" Tag="calculator" />
                                <ComboBoxItem Content="Paint" Tag="paint" />
                                <ComboBoxItem Content="File Explorer" Tag="file-explorer" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="WebsitePickerPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock Text="Website address (HTTPS only)" FontSize="12" Margin="0,0,0,5" />
                            <TextBox x:Name="WebsiteTextBox" Height="34" Padding="8" Text="https://" />
                        </StackPanel>

                        <TextBlock x:Name="FolderActionHint"
                                   Visibility="Collapsed"
                                   Text="When the flow runs, Windows will ask you to choose the folder. The folder path is not saved in the flow."
                                   FontSize="11" Foreground="#AAB6CC" Margin="0,12,0,0" TextWrapping="Wrap" />

                        <Button Content="Add step"
                                Click="AddStep_Click"
                                Margin="0,16,0,0"
                                Padding="12,9"
                                Background="#263A5C"
                                Foreground="White"
                                FontWeight="SemiBold" />

                        <TextBlock Text="FLOW STEPS" FontSize="11" FontWeight="Bold" Foreground="#9CAAC4" Margin="0,22,0,7" />
                        <ListBox x:Name="DraftStepsList"
                                 MinHeight="150"
                                 MaxHeight="220"
                                 Background="#0E1526"
                                 Foreground="#E4ECF8"
                                 BorderBrush="#34415B" />
                        <Button Content="Remove selected step"
                                Click="RemoveStep_Click"
                                Margin="0,8,0,0"
                                Padding="10,8"
                                Background="#263A5C"
                                Foreground="White" />
                        <Button Content="Save flow"
                                Click="SaveFlow_Click"
                                Margin="0,12,0,0"
                                Padding="12,10"
                                Background="#3978E8"
                                Foreground="White"
                                FontWeight="SemiBold" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="#151D32" CornerRadius="16" Padding="18">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="SAVED FLOWS" FontSize="11" FontWeight="Bold" Foreground="#9CAAC4" />
                        <TextBlock Text="Flows are stored locally for this Windows user." FontSize="11" Foreground="#AAB6CC" Margin="0,5,0,12" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Content="Run selected flow"
                                Click="RunFlow_Click"
                                Padding="12,10"
                                Background="#277A55"
                                Foreground="White"
                                FontWeight="SemiBold" />
                        <Button Content="Delete selected flow"
                                Click="DeleteFlow_Click"
                                Margin="0,8,0,0"
                                Padding="10,8"
                                Background="#263A5C"
                                Foreground="White" />
                    </StackPanel>
                    <ListBox x:Name="SavedFlowsList"
                             DisplayMemberPath="Name"
                             Background="#0E1526"
                             Foreground="#E4ECF8"
                             BorderBrush="#34415B" />
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="No scripts • No command shell • No hidden execution • Each run requires your confirmation"
                   FontSize="10"
                   Foreground="#9CAAC4"
                   Margin="2,14,2,0"
                   TextWrapping="Wrap" />
    </Grid>
</Window>