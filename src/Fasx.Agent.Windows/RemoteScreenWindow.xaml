<Window x:Class="Fasx.Agent.Windows.RemoteScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FASX — Share screen"
        Width="1160"
        Height="820"
        MinWidth="860"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#0B1020"
        Foreground="#F4F7FF"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel>
                <TextBlock Text="FASX REMOTE" FontSize="11" FontWeight="Bold" Foreground="#8FB7FF" />
                <TextBlock Text="Share your screen with the approved phone" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,4" />
                <TextBlock Text="Press Start screen sharing in the page, then choose the display or window in the Windows picker."
                           FontSize="13" Foreground="#AAB6CC" TextWrapping="Wrap" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="Stop session"
                    Click="StopSession_Click"
                    Padding="14,9"
                    Margin="18,0,0,0"
                    Background="#6D3540"
                    Foreground="White"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
        </DockPanel>

        <Border Grid.Row="2" Background="#151D32" CornerRadius="18" Padding="12">
            <wv2:WebView2 x:Name="RemoteScreenBrowser" />
        </Border>

        <DockPanel Grid.Row="3" Margin="2,12,2,0">
            <TextBlock x:Name="RemoteScreenStatusText"
                       Text="Initializing the secure screen-sharing page…"
                       Foreground="#AAB6CC"
                       FontSize="11"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock DockPanel.Dock="Right"
                       Text="Visible sharing • Stop ends capture and revokes all session permissions"
                       Foreground="#8FB7FF"
                       FontSize="10"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
