<Window x:Class="Fasx.Agent.Windows.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FASX — PC Health"
        Width="720"
        Height="620"
        MinWidth="620"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#0B1020"
        Foreground="#F4F7FF">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel>
                <TextBlock Text="FASX INTELLIGENCE" FontSize="11" FontWeight="Bold" Foreground="#8FB7FF" />
                <TextBlock Text="PC Health" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" />
                <TextBlock Text="Local read-only information from this Windows computer." FontSize="12" Foreground="#AAB6CC" Margin="0,5,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="Refresh"
                    Click="Refresh_Click"
                    Padding="16,10"
                    Background="#3978E8"
                    Foreground="White"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
        </DockPanel>

        <Border Grid.Row="2" Background="#151D32" CornerRadius="18" Padding="22">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="HealthDetailsText"
                           Text="Reading local system information…"
                           FontFamily="Consolas"
                           FontSize="13"
                           LineHeight="22"
                           Foreground="#DDE7F8"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="No telemetry • No screen capture • No network upload • Refresh runs only when you press the button"
                   Foreground="#AAB6CC"
                   FontSize="10"
                   Margin="2,12,2,0"
                   TextWrapping="Wrap" />
    </Grid>
</Window>