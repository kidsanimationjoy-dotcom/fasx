<Application x:Class="Fasx.Agent.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="FasxBackground" Color="#0B1020" />
        <SolidColorBrush x:Key="FasxPanel" Color="#151D32" />
        <SolidColorBrush x:Key="FasxAccent" Color="#4F8CFF" />
        <SolidColorBrush x:Key="FasxMuted" Color="#AAB6CC" />
    </Application.Resources>
</Application>
