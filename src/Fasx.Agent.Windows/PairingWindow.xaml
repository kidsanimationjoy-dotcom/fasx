<Window x:Class="Fasx.Agent.Windows.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FASX — Pair a device"
        Width="920"
        Height="760"
        MinWidth="760"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#0B1020"
        Foreground="#F4F7FF">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="PAIR A DEVICE" FontSize="11" FontWeight="Bold" Foreground="#8FB7FF" />
            <TextBlock Text="Connect your phone to this computer" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,5" />
            <TextBlock Text="FASX opens a temporary, encrypted local-network pairing window only when you enable it. Every phone request must be approved here."
                       FontSize="13" Foreground="#AAB6CC" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#151D32" CornerRadius="20" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PAIRING INVITATION" FontSize="11" FontWeight="Bold" Foreground="#AAB6CC" />
                        <Border Background="White" CornerRadius="16" Padding="12" HorizontalAlignment="Center" Margin="0,18,0,12">
                            <Image x:Name="PairingQrImage" Width="220" Height="220" Stretch="Uniform" />
                        </Border>
                        <TextBlock x:Name="PairingStatusText"
                                   Text="Pairing is off. Enable it to create a one-time invitation."
                                   Foreground="#AAB6CC" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock x:Name="PairingEndpointText" Margin="0,10,0,0" Foreground="#8FB7FF" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock x:Name="PairingExpiryText" Margin="0,6,0,0" Foreground="#AAB6CC" FontSize="11" />
                        <Button x:Name="StartPairingButton"
                                Content="Enable local pairing"
                                Click="StartPairing_Click"
                                Margin="0,18,0,0"
                                Padding="14,11"
                                Background="#3978E8"
                                Foreground="White"
                                FontWeight="SemiBold" />
                        <Button x:Name="StopPairingButton"
                                Content="Stop pairing"
                                Click="StopPairing_Click"
                                Margin="0,8,0,0"
                                Padding="12,9"
                                Background="#26334D"
                                Foreground="White"
                                Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="#151D32" CornerRadius="20" Padding="22">
                <StackPanel>
                    <TextBlock Text="PHONE REQUESTS" FontSize="11" FontWeight="Bold" Foreground="#AAB6CC" />
                    <TextBlock Text="Approve only devices you recognize and are holding."
                               Margin="0,8,0,16" Foreground="#AAB6CC" FontSize="12" TextWrapping="Wrap" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="430">
                        <StackPanel x:Name="PendingPairingsPanel">
                            <TextBlock Text="No pending pairing requests." Foreground="#8190AA" FontSize="13" />
                        </StackPanel>
                    </ScrollViewer>
                    <Separator Margin="0,18,0,14" Background="#34415B" />
                    <TextBlock Text="PAIRED DEVICES" FontSize="11" FontWeight="Bold" Foreground="#AAB6CC" />
                    <TextBlock x:Name="PairedDevicesCountText" Text="0 trusted devices" Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="LAN pairing only • No internet relay • Close this window or press Stop pairing to end the listener."
                   Foreground="#AAB6CC"
                   FontSize="10"
                   Margin="2,16,2,0"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
