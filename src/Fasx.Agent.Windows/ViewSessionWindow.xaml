<Window x:Class="Fasx.Agent.Windows.ViewSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FASX — View-only session"
        Width="900"
        Height="720"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B1020"
        Foreground="#F4F7FF"
        Closed="Window_Closed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="15" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="FASX REMOTE" FontSize="11" FontWeight="Bold" Foreground="#8FB7FF" />
            <TextBlock Text="Create a view-only session" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,4" />
            <TextBlock Text="Only the selected paired phone can request this session. You must approve View screen on this computer."
                       FontSize="13" Foreground="#AAB6CC" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#151D32" CornerRadius="20" Padding="22">
                <StackPanel>
                    <TextBlock Text="SELECT PAIRED PHONE" FontSize="11" FontWeight="Bold" Foreground="#AAB6CC" />
                    <ComboBox x:Name="PairedDeviceCombo"
                              DisplayMemberPath="DeviceName"
                              SelectionChanged="PairedDeviceCombo_SelectionChanged"
                              Margin="0,12,0,0"
                              Padding="10"
                              Background="#202C45"
                              Foreground="#101725" />
                    <TextBlock Text="VIEW SCREEN PERMISSION" FontSize="11" FontWeight="Bold" Foreground="#AAB6CC" Margin="0,24,0,8" />
                    <Border Background="#202C45" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Included" FontWeight="SemiBold" Foreground="#8FE0B1" />
                            <TextBlock Text="• View the selected display/window" Margin="0,8,0,0" FontSize="13" />
                            <TextBlock Text="Not included" FontWeight="SemiBold" Foreground="#F2C477" Margin="0,16,0,0" />
                            <TextBlock Text="• Mouse or keyboard control" Margin="0,8,0,0" FontSize="13" />
                            <TextBlock Text="• Files, clipboard or audio" Margin="0,4,0,0" FontSize="13" />
                            <TextBlock Text="• Shutdown, restart or other power actions" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="CreateInviteButton"
                            Content="Create view invitation"
                            Click="CreateInvite_Click"
                            Margin="0,18,0,0"
                            Padding="12,11"
                            Background="#3978E8"
                            Foreground="White"
                            FontWeight="SemiBold" />
                    <Button x:Name="StopSessionButton"
                            Content="Stop session"
                            Click="StopSession_Click"
                            Margin="0,8,0,0"
                            Padding="11,9"
                            Background="#26334D"
                            Foreground="White"
                            Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#151D32" CornerRadius="20" Padding="22">
                <StackPanel>
                    <TextBlock Text="ONE-TIME INVITATION" FontSize="11" FontWeight="Bold" Foreground="#AAB6CC" />
                    <Border Background="White" CornerRadius="16" Padding="10" HorizontalAlignment="Center" Margin="0,16,0,12">
                        <Image x:Name="ViewQrImage" Width="210" Height="210" Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="SessionStatusText"
                               Text="Select a paired phone and create an invitation."
                               Foreground="#AAB6CC"
                               FontSize="13"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SessionEndpointText" Foreground="#8FB7FF" FontSize="12" Margin="0,10,0,0" />
                    <TextBlock x:Name="SessionExpiryText" Foreground="#AAB6CC" FontSize="11" Margin="0,6,0,0" />
                    <Separator Margin="0,16,0,12" Background="#34415B" />
                    <TextBlock Text="LOCAL APPROVAL" FontSize="11" FontWeight="Bold" Foreground="#AAB6CC" />
                    <TextBlock x:Name="ApprovalDescriptionText"
                               Text="No phone request received."
                               Foreground="#AAB6CC"
                               FontSize="12"
                               Margin="0,8,0,10"
                               TextWrapping="Wrap" />
                    <Button x:Name="StartStreamButton"
                            Content="Start screen sharing…"
                            Click="StartStream_Click"
                            Padding="11,8"
                            Margin="0,0,0,10"
                            Background="#3978E8"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Visibility="Collapsed" />
                    <StackPanel x:Name="ApprovalButtons" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Content="Approve View screen"
                                Click="ApproveView_Click"
                                Padding="10,8"
                                Background="#277A55"
                                Foreground="White"
                                FontWeight="SemiBold" />
                        <Button Content="Deny"
                                Click="DenyView_Click"
                                Margin="8,0,0,0"
                                Padding="12,8"
                                Background="#6D3540"
                                Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="Same trusted Wi-Fi only • 2-minute invitation • View screen only • Capture/stream is a separate next step"
                   Foreground="#AAB6CC"
                   FontSize="10"
                   Margin="2,16,2,0"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
