<Window x:Class="Fasx.Agent.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FASX Windows Companion"
        Width="1020"
        Height="740"
        MinWidth="800"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FasxBackground}"
        Foreground="#F4F7FF">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <Border DockPanel.Dock="Left"
                    Width="48"
                    Height="48"
                    CornerRadius="14"
                    Background="{StaticResource FasxAccent}">
                <TextBlock Text="F"
                           FontSize="27"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="14,1,0,0" VerticalAlignment="Center">
                <TextBlock Text="FASX" FontSize="25" FontWeight="Bold" />
                <TextBlock Text="WINDOWS COMPANION" FontSize="10" Foreground="{StaticResource FasxMuted}" />
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    Background="#242F45"
                    CornerRadius="16"
                    Padding="14,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#8A96AB" VerticalAlignment="Center" />
                    <TextBlock Text="  NOT CONNECTED" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </DockPanel>

        <Border Grid.Row="2"
                Background="{StaticResource FasxPanel}"
                CornerRadius="22"
                Padding="26">
            <StackPanel>
                <TextBlock Text="Your computer. Your command centre."
                           FontSize="26"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="FASX is installed on this computer as a visible companion. Remote sessions will require deliberate local approval and specific permissions."
                           Margin="0,10,0,18"
                           Foreground="{StaticResource FasxMuted}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           MaxWidth="820" />
                <Border Background="#202C45" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="FOUNDATION BUILD" Foreground="#8FB7FF" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="Local PC Health is available. Device pairing, screen streaming, and remote input are not enabled in this build."
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="13" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource FasxPanel}" CornerRadius="20" Padding="22">
                <StackPanel>
                    <TextBlock Text="SESSION STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource FasxMuted}" />
                    <TextBlock Text="No active session" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,5" />
                    <TextBlock Text="This computer is not currently sharing its screen or accepting remote input."
                               Foreground="{StaticResource FasxMuted}"
                               TextWrapping="Wrap"
                               FontSize="13" />
                    <Separator Margin="0,22,0,18" Background="#34415B" />
                    <TextBlock Text="LOCAL SAFETY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource FasxMuted}" />
                    <TextBlock Text="• No hidden remote access" Margin="0,12,0,5" FontSize="13" />
                    <TextBlock Text="• Local approval required for pairing" Margin="0,0,0,5" FontSize="13" />
                    <TextBlock Text="• Permissions are granted per session" Margin="0,0,0,5" FontSize="13" />
                    <TextBlock Text="• Local user can end an active session" Margin="0,0,0,5" FontSize="13" />
                    <Separator Margin="0,22,0,18" Background="#34415B" />
                    <TextBlock Text="FASX MODULES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource FasxMuted}" />
                    <TextBlock Text="SmartDeck · File Bridge · Security Shield" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" />
                    <Separator Margin="0,20,0,14" Background="#34415B" />
                    <TextBlock Text="LOCAL DEVICE IDENTITY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource FasxMuted}" />
                    <TextBlock x:Name="DeviceIdValue"
                               Text="Creating identity…"
                               Margin="0,10,0,4"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="IdentityStatusValue"
                               Text="Private key will be protected for this Windows account."
                               FontSize="10"
                               Foreground="#8FB7FF"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource FasxPanel}" CornerRadius="20" Padding="22">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="LOCAL PC HEALTH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource FasxMuted}" />
                        <Button DockPanel.Dock="Right"
                                Content="Refresh"
                                Click="RefreshHealthButton_Click"
                                Padding="12,5"
                                Background="#2A3D5D"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand" />
                    </DockPanel>
                    <TextBlock Text="Read-only computer status" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Windows" Foreground="{StaticResource FasxMuted}" FontSize="12" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OsValue" Text="Reading…" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Text="Processors" Foreground="{StaticResource FasxMuted}" FontSize="12" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ProcessorValue" Text="Reading…" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="4" Text="Physical memory" Foreground="{StaticResource FasxMuted}" FontSize="12" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="MemoryValue" Text="Reading…" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="6" Text="System drive" Foreground="{StaticResource FasxMuted}" FontSize="12" />
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="DiskValue" Text="Reading…" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="8" Text="Battery" Foreground="{StaticResource FasxMuted}" FontSize="12" />
                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="BatteryValue" Text="Reading…" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="10" Text="System uptime" Foreground="{StaticResource FasxMuted}" FontSize="12" />
                        <TextBlock Grid.Row="10" Grid.Column="1" x:Name="UptimeValue" Text="Reading…" FontSize="12" FontWeight="SemiBold" />
                    </Grid>
                    <Separator Margin="0,20,0,12" Background="#34415B" />
                    <TextBlock x:Name="HealthUpdatedValue"
                               Text="Reading local system information…"
                               Foreground="{StaticResource FasxMuted}"
                               FontSize="10"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Information is read locally and is not sent anywhere in this build."
                               Foreground="#8FB7FF"
                               FontSize="10"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="5" Margin="2,18,2,0">
            <TextBlock Text="FASX FOUNDATION • REMOTE FEATURES NOT YET ENABLED"
                       Foreground="{StaticResource FasxMuted}"
                       FontSize="10"
                       VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right"
                       Text="Visible by design"
                       Foreground="#8FB7FF"
                       FontSize="11"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
