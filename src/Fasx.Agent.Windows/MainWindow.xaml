<Window x:Class="Fasx.Agent.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FASX Windows Companion"
        Width="960"
        Height="700"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FasxBackground}"
        Foreground="#F4F7FF">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <Border DockPanel.Dock="Left"
                    Width="48"
                    Height="48"
                    CornerRadius="14"
                    Background="{StaticResource FasxAccent}">
                <TextBlock Text="F"
                           FontSize="27"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="14,1,0,0" VerticalAlignment="Center">
                <TextBlock Text="FASX" FontSize="25" FontWeight="Bold" />
                <TextBlock Text="WINDOWS COMPANION" FontSize="10" Foreground="{StaticResource FasxMuted}" />
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    Background="#242F45"
                    CornerRadius="16"
                    Padding="14,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#8A96AB" VerticalAlignment="Center" />
                    <TextBlock Text="  NOT CONNECTED" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </DockPanel>

        <Border Grid.Row="2"
                Background="{StaticResource FasxPanel}"
                CornerRadius="22"
                Padding="26">
            <StackPanel>
                <TextBlock Text="Your computer. Your command centre."
                           FontSize="26"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="FASX is installed on this computer as a visible companion. You control when a remote session can begin and which permissions it receives."
                           Margin="0,10,0,18"
                           Foreground="{StaticResource FasxMuted}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           MaxWidth="760" />
                <Border Background="#202C45" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="FOUNDATION BUILD" Foreground="#8FB7FF" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="FASX includes the visible Windows companion, a local approval flow, and protected paired-device storage. Remote desktop streaming and input are not yet enabled."
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="13" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource FasxPanel}" CornerRadius="20" Padding="22">
                <StackPanel>
                    <TextBlock Text="SESSION STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource FasxMuted}" />
                    <TextBlock Text="No active session" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,5" />
                    <TextBlock Text="This computer is not currently sharing its screen or accepting remote input."
                               Foreground="{StaticResource FasxMuted}"
                               TextWrapping="Wrap"
                               FontSize="13" />
                    <Separator Margin="0,22,0,18" Background="#34415B" />
                    <TextBlock Text="LOCAL SAFETY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource FasxMuted}" />
                    <TextBlock Text="• No hidden remote access" Margin="0,12,0,5" FontSize="13" />
                    <TextBlock Text="• Local approval required for pairing" Margin="0,0,0,5" FontSize="13" />
                    <TextBlock Text="• Permissions are granted per session" Margin="0,0,0,5" FontSize="13" />
                    <TextBlock Text="• Local user can end a session" Margin="0,0,0,5" FontSize="13" />
                    <Button Content="Pair a phone"
                            Click="PairDevices_Click"
                            Margin="0,14,0,0"
                            Padding="12,10"
                            Background="#3978E8"
                            Foreground="White"
                            FontWeight="SemiBold" />
                    <Button Content="Preview screen capture"
                            Click="PreviewScreen_Click"
                            Margin="0,8,0,0"
                            Padding="12,10"
                            Background="#263A5C"
                            Foreground="White"
                            FontWeight="SemiBold" />
                    <Button Content="Request view-only session"
                            Click="ViewSession_Click"
                            Margin="0,8,0,0"
                            Padding="12,10"
                            Background="#277A55"
                            Foreground="White"
                            FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource FasxPanel}" CornerRadius="20" Padding="22">
                <StackPanel>
                    <TextBlock Text="FASX MODULES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource FasxMuted}" />
                    <TextBlock Text="SmartDeck" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,3" />
                    <TextBlock Text="Personal command centre" Foreground="{StaticResource FasxMuted}" FontSize="12" />
                    <TextBlock Text="File Bridge" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,3" />
                    <TextBlock Text="Approved file transfers" Foreground="{StaticResource FasxMuted}" FontSize="12" />
                    <TextBlock Text="PC Health" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,3" />
                    <TextBlock Text="Local device diagnostics" Foreground="{StaticResource FasxMuted}" FontSize="12" />
                    <Button Content="Open PC Health"
                            Click="Diagnostics_Click"
                            Margin="0,8,0,0"
                            Padding="10,7"
                            Background="#263A5C"
                            Foreground="White"
                            FontWeight="SemiBold" />
                    <TextBlock Text="Security Shield" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,3" />
                    <TextBlock Text="Pairing and session permissions" Foreground="{StaticResource FasxMuted}" FontSize="12" />
                    <TextBlock Text="Paired devices" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,2" />
                    <TextBlock x:Name="PairedDevicesValue" Text="0" FontSize="24" FontWeight="Bold" Foreground="#8FB7FF" />
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="5" Margin="2,18,2,0">
            <TextBlock Text="FASX FOUNDATION • LAN PAIRING IS USER-STARTED"
                       Foreground="{StaticResource FasxMuted}"
                       FontSize="10"
                       VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right"
                       Text="Visible by design"
                       Foreground="#8FB7FF"
                       FontSize="11"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
